{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:host((?!.*\\.(?:jpg|jpeg|png|gif|webp|svg|ico|css|js|json|txt|xml|pdf|mp4|mov|webm|map|html|woff|woff2|ttf|otf|JPG|JPEG|PNG|GIF|WEBP|PDF|MP4|MOV)$)[a-zA-Z0-9-]+\\.[a-zA-Z0-9.-]*[a-zA-Z]{2,})",
      "destination": "/api/go?host=:host"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
